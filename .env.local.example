OPENAI_API_KEY=sk-...
# OpenAI project ID (Settings → your project) so requests bill to that project, not the org default.
# OPENAI_PROJECT_ID=proj_...
# Required for unauthenticated cron/external worker calls to /api/jobs/run.
# Browser calls from signed-in users only process that user's queued jobs.
# JOB_RUNNER_SECRET=replace-with-a-long-random-value
# Comma-separated emails that should be provisioned as Pro without Stripe.
# Useful for owner/beta accounts before billing launches.
# FOLIO_OWNER_EMAILS=you@example.com

# ─── Pipeline v3 role models (blank/whitespace env values are ignored) ───
# Defaults are snapshotted onto each project at create time (Literary Pro route).
# OPENAI_PLANNER_MODEL=gpt-5.6-sol
# OPENAI_PLAN_AUDITOR_MODEL=gpt-5.6-terra
# OPENAI_BOOK_AUDITOR_MODEL=gpt-5.6-sol
# OPENAI_WRITER_MODEL_FREE=gpt-5.6-luna
# OPENAI_WRITER_MODEL_PRO=gpt-5.6-sol
# OPENAI_CRITIC_MODEL=gpt-5.6-terra
# OPENAI_REVISE_MODEL_FREE=gpt-5.6-luna
# OPENAI_REVISE_MODEL_PRO=gpt-5.6-sol
# OPENAI_REVISION_VERIFIER_MODEL=gpt-5.6-luna
# OPENAI_IMAGE_MODEL=gpt-image-2

# Optional Balanced Pro: Terra writer while reviser stays Sol (do not set as default).
# OPENAI_WRITER_MODEL_PRO=gpt-5.6-terra
# OPENAI_REVISE_MODEL_PRO=gpt-5.6-sol

# Legacy writer fallbacks (still blank-safe; prefer role-specific vars above).
# OPENAI_FREE_MODEL=gpt-5.6-luna
# OPENAI_PRO_MODEL=gpt-5.6-sol
# OPENAI_MODEL=gpt-5.6-sol

# Ceiling on prose tokens fed to the writer (guard rail; above every preset).
# FOLIO_WRITER_CONTEXT_TOKEN_BUDGET=400000

# Neon Postgres. Vercel Marketplace injects DATABASE_URL automatically.
DATABASE_URL=postgres://user:password@host/database?sslmode=require

# Vercel Blob. Vercel Blob injects BLOB_READ_WRITE_TOKEN automatically.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Optional Notion mirror for generated books.
# Use an internal integration token with access to the Folio Book Projects database.
NOTION_API_KEY=secret_...
NOTION_BOOKS_DATABASE_ID=08d8fb40c86d4420b2196876e4baa6a5

# Stripe Billing foundation. Leave unset until you are ready to test Checkout.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
NEXT_PUBLIC_APP_URL=http://localhost:3000
